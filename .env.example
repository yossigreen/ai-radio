# Copy to .env (gitignored): cp .env.example .env
# The values match the defaults in compose.yaml. Local development only; never real secrets.

# apps/server
DATABASE_URL=postgres://airadio:airadio-dev@localhost:5432/airadio
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
API_PORT=3001

# apps/web (Next.js reads apps/web/.env*, so this one is a reference; the code defaults to it)
API_URL=http://localhost:3001
