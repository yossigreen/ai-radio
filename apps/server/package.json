{
  "name": "@ai-radio/server",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "start:api": "node --env-file-if-exists=../../.env dist/main.api.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/main.worker.js",
    "start:playout": "node --env-file-if-exists=../../.env dist/main.playout.js"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@temporalio/worker": "1.26.0",
    "@temporalio/workflow": "1.26.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.6.0",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@temporalio/testing": "1.26.0",
    "@testcontainers/postgresql": "12.2.2",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.2",
    "typescript": "6.0.3"
  }
}
